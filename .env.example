# ==============================================================================
# BhujanRakshak Environment Configuration
# ==============================================================================
# Replace with your Supabase Project settings (Project Settings -> API)
# If left blank or untouched, BhujanRakshak will gracefully fall back to an active
# in-memory / LocalStorage simulation so all features can be evaluated without setup.
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
