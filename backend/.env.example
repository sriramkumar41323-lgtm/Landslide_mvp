# ==============================================================================
# BhujanRakshak FastAPI Backend Environment Configuration
# ==============================================================================

# Supabase PostgreSQL Configuration
# Found in your Supabase project dashboard under Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Twilio SMS Emergency Alert Dispatcher
# Optional for local demo; if omitted, alerts are safely simulated and logged to Supabase alert_log
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Fast2SMS Indian Direct Carrier SMS (Optional)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Free Mobile Push Notification (ntfy.sh - Zero account, instant push to phone)
NTFY_TOPIC=bhujanrakshak_alerts

# Server Configuration
PORT=8000
HOST=0.0.0.0
SCHEDULE_INTERVAL_HOURS=1

